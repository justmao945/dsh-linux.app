#!/usr/bin/env bash
# Install dsh-web for the current user, no root needed:
#   ~/.local/bin/dsh-web                      launcher command
#   ~/.local/share/applications/dsh-web.desktop  launcher entry
#   ~/.local/share/icons/hicolor/scalable/apps/dsh-web.svg  icon
# For a system-wide package use pkgbuild/PKGBUILD with makepkg -fsi.
set -euo pipefail
cd "$(dirname "$0")/.."

install -Dm755 bin/dsh-web "$HOME/.local/bin/dsh-web"
install -Dm644 pkgbuild/dsh-web.desktop "$HOME/.local/share/applications/dsh-web.desktop"
install -Dm644 pkgbuild/dsh-web.svg "$HOME/.local/share/icons/hicolor/scalable/apps/dsh-web.svg"

command -v update-desktop-database >/dev/null 2>&1 \
	&& update-desktop-database "$HOME/.local/share/applications" || true

echo "installed: $HOME/.local/bin/dsh-web"
